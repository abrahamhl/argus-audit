// Production-shaped deployment configuration.
// Single Worker serves the API under /api/* and the built React app for
// every other route. Free-tier defaults; no paid features are required.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argus-audit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ABUSE_GUARD", "class_name": "AbuseGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AbuseGuard"] }],
  "vars": {
    "AUDIT_MODE": "live",
    "AI_EXPLANATIONS": "off",
    "DAILY_AUDIT_CAP": "500",
    "TURNSTILE_SITE_KEY": ""
  }
  // Optional later (kept out until V0.4 saved audits / report artifacts):
  // "d1_databases": [{ "binding": "DB", "database_name": "argus-audit", "database_id": "<id>" }],
  // "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "argus-audit-reports" }]
}
