{
  "name": "@argus-audit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker API for Argus Audit (passive website audit).",
  "scripts": {
    "dev": "node scripts/ensure-assets.mjs && wrangler dev --port 8787",
    "dev:fixture": "node scripts/ensure-assets.mjs && wrangler dev --port 8787 --var AUDIT_MODE:fixture",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@argus-audit/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
